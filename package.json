    "@tiptap/starter-kit": "3.32.1",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
